{
  "name": "autopostule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "start": "node dist/server.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "firebase:login": "node node_modules/firebase-tools/lib/bin/firebase.js login",
    "deploy:rules": "node node_modules/firebase-tools/lib/bin/firebase.js deploy --only firestore:rules",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "test:e2e": "node e2e/run.mjs",
    "check:ai": "node --import tsx scripts/check-ai.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.55.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
