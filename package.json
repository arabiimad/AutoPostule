{
  "name": "autopostule",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node node_modules/vite/bin/vite.js build && node scripts/build-server.mjs",
    "start": "node build/server/server.cjs",
    "worker": "node node_modules/tsx/dist/cli.mjs server/worker.ts",
    "start:worker": "node build/server/worker.cjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true });\"",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "check:prod": "node --import tsx scripts/preflight.ts",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:worker": "node --import tsx e2e/worker.e2e.ts",
    "test:e2e:automation": "node --import tsx e2e/automation-ui.e2e.ts",
    "test:e2e:accounts": "node e2e/local-supabase.mjs",
    "check:ai": "node --import tsx scripts/check-ai.ts",
    "test:supabase": "node e2e/supabase-live.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@sentry/node": "^11.0.0",
    "@sentry/react": "^11.0.0",
    "@supabase/supabase-js": "^2.117.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "playwright": "^1.55.0",
    "posthog-js": "^1.434.12",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
