# Clé Google Gemini (pour adaptation IA des CV et lettres)
GEMINI_API_KEY=votre_cle_gemini_ici

# Modèles utilisés pour le CV et la lettre (npm run check:ai pour vérifier votre clé)
#   - BEST : rédaction (CV, lettre, retouches). Les modèles Pro exigent un projet Google Cloud AVEC facturation
#     (l'abonnement Google AI Pro de l'application Gemini ne donne pas accès à l'API). Sans facturation : repli automatique sur FAST.
#   - FAST : analyse de l'offre, CV importé, etc.
# GEMINI_MODEL_BEST=gemini-3.1-pro-preview
# GEMINI_MODEL_FAST=gemini-3.8-flash

# Mode d'authentification ("optional", "required", ou "off")
AUTH_MODE=optional

# Comptes et base de données (Supabase, région UE) — voir README
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Interface (publiques par conception ; données protégées par les règles RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_AUTH_GOOGLE=on   # après activation du fournisseur Google dans Supabase

# Freemium : quotas mensuels (QUOTAS=off pour les désactiver en développement)
# QUOTAS=on
# QUOTA_FREE_CV=3  QUOTA_FREE_LETTER=3  QUOTA_FREE_REWRITE=15  QUOTA_FREE_INTERVIEW=3  QUOTA_FREE_IMPORT=5
# QUOTA_PREMIUM_CV=150  QUOTA_PREMIUM_LETTER=150  QUOTA_PREMIUM_REWRITE=600  QUOTA_PREMIUM_INTERVIEW=80  QUOTA_PREMIUM_IMPORT=30

# Paiement Premium (Stripe) — voir README
STRIPE_SECRET_KEY=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=
# Adresse publique de l'application (retours de paiement) ; par défaut : l'adresse de la requête
# APP_URL=https://autopostule.fr
# Prix affiché sur la page Tarifs
# VITE_PREMIUM_PRICE=9,99 €

# --- Accès API Offres Réelles (Optionnel : sans ces clés, l'application fonctionne en mode démo indicatif) ---
# 1. La bonne alternance (clé sandbox ou prod sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil)
LBA_API_KEY=

# 2. France Travail (API Offres d'emploi v2 sur https://francetravail.io/data/api/offres-emploi)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# 3. Google Jobs via JSearch (offres publiées sur LinkedIn, Indeed, Welcome to the Jungle, Glassdoor…)
#    Clé gratuite (≈ 200 requêtes/mois) sur https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# 4. Adzuna (agrégateur d'offres) — identifiants gratuits sur https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# 5. Jooble (agrégateur, quota limité à 500 requêtes par clé) — https://jooble.org/api/about
JOOBLE_API_KEY=
#    Clé internationale (jooble.org) : résultats souvent hors de France, filtrés automatiquement.
#    Pour des offres françaises, demandez une clé fr.jooble.org puis indiquez : JOOBLE_HOST=https://fr.jooble.org

# --- Serveur ---
# Port d'écoute (fourni automatiquement par la plupart des hébergeurs)
PORT=3000

# --- Plusieurs instances (facultatif) ---
# Redis Upstash (offre gratuite) : cache des recherches, limite de débit et compteurs de quotas partagés.
# Sans ces variables, tout reste en mémoire (suffisant pour un seul serveur).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Quotas des offres gratuites (compteurs affichés dans /api/jobs/sources) ---
# JSEARCH_MONTHLY_QUOTA=200
# ADZUNA_MONTHLY_QUOTA=2500
# JOOBLE_TOTAL_QUOTA=500
# Attente maximale de Google Jobs avant d'afficher les autres résultats (ms)
# JSEARCH_WAIT_MS=12000

# PDF Web (Chromium via Playwright) : `npx playwright install chromium` une fois
# PW_CHROMIUM_PATH=/chemin/vers/chromium   # Chromium déjà installé
# WEB_PDF=off                              # désactive le moteur Web
# PDF_CONCURRENCY=3

# Suivi des erreurs (Sentry) et mesure d'usage (PostHog, région UE, sans cookie) — facultatifs
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# --- Candidature automatique (worker séparé : npm run worker / node build/server/worker.cjs) ---
# Base Supabase en connexion directe (Project Settings → Database → Connection string, mode session)
# AUTOMATION_DATABASE_URL=postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Clé de chiffrement des jetons de messagerie (32 octets en base64 : openssl rand -base64 32). Ne jamais la changer après usage.
# AUTOMATION_TOKEN_KEY=
# Adresse publique du site (retour OAuth : PUBLIC_URL/api/automation/oauth/<gmail|outlook>/callback)
# PUBLIC_URL=https://kareer.pro
# Application OAuth Google (scope gmail.send) et Microsoft (Mail.Send, offline_access)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Bêta : candidatures maximum par jour et par utilisateur (défaut 5), recherches toutes les N heures (défaut 12)
# AUTOMATION_MAX_DAILY=5
# AUTOMATION_SEARCH_EVERY_HOURS=12
# Notifications sur le téléphone (Web Push) : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@kareer.pro
# Envoi par l'API officielle de La bonne alternance (utilise LBA_API_KEY ; habilitation « applications:write » :
# automatique avec une clé bac à sable, sur demande à La bonne alternance en production). "off" pour désactiver.
# LBA_APPLY=on
# Découverte d'offres au-delà des sites d'emploi (recherche planifiée) :
#   pages carrière Greenhouse / Lever / Ashby / SmartRecruiters, apprises à chaque lien rencontré ;
#   ATS_BOARDS en ajoute à la main, ex. : smartrecruiters:BoschGroup,greenhouse:acme,lever:globex
# ATS_BOARDS=
#   publications « on recrute » via la recherche Google de Gemini (GEMINI_API_KEY requise) ; "off" pour désactiver
# DISCOVERY_WEB=on
#   zone couverte (première version : FR uniquement)
# DISCOVERY_COUNTRY=FR
# Supervision de l'auto-candidature (GET /api/admin/automation) : identifiants des comptes exploitants
# ADMIN_UIDS=
# Conservation des preuves détaillées d'envoi (jours)
# AUTOMATION_PROOF_DAYS=180
# --- Base d'offres : collecte continue (worker, migration 007) ---
# INGEST_FT=on                      collecte France Travail (et ses partenaires) dans la base
# INGEST_FT_EVERY_MINUTES=60        nouveautés
# INGEST_FT_FULL_EVERY_HOURS=24     balayage complet (offres retirées désactivées)
# FT_SYNC_RPS=3                     appels par seconde vers l'API France Travail
# INGEST_SITES=on                   collecte des offres publiées sur les sites des employeurs (JobPosting)
# INGEST_SITES_EVERY_MINUTES=60
# INGEST_SITES_PER_RUN=40           sites visités par collecte
# CAREER_SITES=exemple.fr,recrutement.autre.fr   sites à visiter en plus des employeurs des offres collectées
# JOBS_INDEX=on                     recherches : partie France Travail lue dans la base (instantané, sans quota)
