rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Profil : lisible / modifiable uniquement par son propriétaire,
    // et le champ userId doit correspondre au compte connecté.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;

      match /applications/{applicationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId;
      }
    }

    // Base d'offres partagée : lecture seule côté client (l'application n'y écrit pas).
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if false;
    }

    // Agent de candidature (automation_tasks, users/{uid}/vault, answers, submissions, devices…) :
    // accès réservé au serveur (firebase-admin). Le navigateur passe par /api/automation.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
